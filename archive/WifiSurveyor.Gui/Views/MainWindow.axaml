<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WifiSurveyor.Gui.Views"
        x:Class="WifiSurveyor.Gui.Views.MainWindow"
        Title="Wi-Fi Surveyor" Width="1360" Height="860"
        Foreground="{StaticResource InkBrush}" Background="White" FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="10,5"
            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Text="Ready"/>
    </Border>

    <TabControl>
      <TabItem Header="Survey"><views:SurveyView x:Name="SurveyTab"/></TabItem>
      <TabItem Header="Discover"><views:DiscoverView/></TabItem>
      <TabItem Header="Capture"><views:CaptureView/></TabItem>
      <TabItem Header="Devices"><views:DevicesView/></TabItem>
    </TabControl>
  </DockPanel>
</Window>
