<UserControl x:Class="WifiSurveyor.Views.SurveyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: controls -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14">

          <TextBlock Text="Project" Style="{StaticResource SectionHeader}"/>
          <WrapPanel>
            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" IsEnabled="False"/>
            <Button Content="New" Click="New_Click"/>
            <Button Content="Open…" Click="Open_Click"/>
            <Button Content="Save" Click="Save_Click"/>
            <Button Content="Save as…" Click="SaveAs_Click"/>
          </WrapPanel>
          <Button Content="Load floor plan image…" Click="LoadPlan_Click" HorizontalAlignment="Left"/>
          <TextBlock x:Name="ProjectInfo" Style="{StaticResource Hint}"/>

          <TextBlock Text="What a click does" Style="{StaticResource SectionHeader}"/>
          <RadioButton x:Name="ModeSurvey" GroupName="Mode" IsChecked="True" Checked="Mode_Changed"
                       Content="Measure at this spot"/>
          <RadioButton x:Name="ModeSelect" GroupName="Mode" Checked="Mode_Changed"
                       Content="Select a point"/>
          <RadioButton x:Name="ModeCalibrate" GroupName="Mode" Checked="Mode_Changed"
                       Content="Set the scale"/>
          <RadioButton x:Name="ModeGeoref" GroupName="Mode" Checked="Mode_Changed"
                       Content="Pin a GPS location"/>
          <RadioButton x:Name="ModeWall" GroupName="Mode" Checked="Mode_Changed"
                       Content="Walls: draw and edit"/>
          <RadioButton x:Name="ModeWalk" GroupName="Mode" Checked="Mode_Changed"
                       Content="Walk test: mark where I am"/>

          <StackPanel x:Name="WalkPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Hint}"
                       Text="Start the run, then walk. Every adapter stays connected and its drops, roams, and rate collapses are recorded. Click the plan as you pass known spots; events in between are placed along your path by time. With GPS pinned and a good fix, positions come automatically."/>
            <CheckBox x:Name="WalkThroughput" Content="Keep running speed tests while walking"
                      ToolTip="Uses the adapters and servers assigned on the Clients tab"/>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
              <TextBlock Text="each test" Style="{StaticResource Label}"/>
              <TextBox x:Name="WalkSeconds" Text="3" Width="36"/>
              <TextBlock Text="seconds" Style="{StaticResource Label}"/>
            </StackPanel>
            <WrapPanel>
              <Button x:Name="WalkButton" Content="Start the run" Click="Walk_Click" MinWidth="110"/>
              <Button Content="Clear walk data" Click="ClearWalk_Click"/>
            </WrapPanel>
            <TextBlock x:Name="WalkInfo" Style="{StaticResource Hint}"/>
          </StackPanel>

          <StackPanel x:Name="WallPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Hint}"
                       Text="Click each end to draw a wall, or click an existing one to select it and drag its ends to adjust. Walls are used when estimating where a transmitter is, so a signal that has to pass through concrete isn't mistaken for a distant one."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Detail" Style="{StaticResource Label}"/>
              <ComboBox x:Name="DetectDetail" SelectedIndex="1" Width="110">
                <ComboBoxItem Content="Main walls"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="Fine detail"/>
              </ComboBox>
              <Button x:Name="DetectButton" Content="Find walls in the plan" Click="DetectWalls_Click"/>
            </StackPanel>
            <Button x:Name="InferButton" Content="Guess walls from the measurements"
                    Click="InferWalls_Click" HorizontalAlignment="Left"
                    ToolTip="Places barriers wherever the signal drops more between two neighbouring points than distance explains"/>
            <WrapPanel x:Name="SuggestionButtons" Visibility="Collapsed">
              <Button Content="Keep all found" Click="KeepSuggestions_Click"/>
              <Button Content="Discard found" Click="DiscardSuggestions_Click"/>
            </WrapPanel>
            <TextBlock Text="Material of the selected wall" Style="{StaticResource Label}"/>
            <ComboBox x:Name="MaterialBox" SelectionChanged="Material_Changed"/>
            <WrapPanel>
              <Button Content="Delete selected" Click="DeleteWall_Click"/>
              <Button Content="Remove last" Click="RemoveWall_Click"/>
              <Button Content="Remove guessed" Click="RemoveInferred_Click"/>
              <Button Content="Remove all" Click="ClearWalls_Click"/>
            </WrapPanel>
            <TextBlock x:Name="WallInfo" Style="{StaticResource Hint}"/>
          </StackPanel>

          <StackPanel x:Name="SelectPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <Button Content="Delete selected point" Click="DeletePoint_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="SelectedInfo" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>

          <StackPanel x:Name="CalibratePanel" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Hint}"
                       Text="Click both ends of something whose length you know, such as a wall, then enter that length."/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="CalibMeters" Width="70"/>
              <TextBlock Text="meters" Style="{StaticResource Label}"/>
              <Button Content="Set scale" Click="ApplyCalibration_Click"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="GeorefPanel" Visibility="Collapsed" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Hint}"
                       Text="Click a spot on the plan, enter its coordinates (or stand there and use the GPS fix), then add the pin. Two or more pins, spread apart, link the plan to GPS."/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Lat" Style="{StaticResource Label}"/>
              <TextBox x:Name="GeoLat" Width="100"/>
              <TextBlock Text="Lon" Style="{StaticResource Label}"/>
              <TextBox x:Name="GeoLon" Width="100"/>
            </StackPanel>
            <WrapPanel>
              <Button Content="Use GPS fix" Click="UseGpsForAnchor_Click"/>
              <Button Content="Add pin" Click="AddAnchor_Click"/>
              <Button Content="Remove all pins" Click="ClearAnchors_Click"/>
            </WrapPanel>
            <TextBlock x:Name="GeorefInfo" Style="{StaticResource Hint}"/>
          </StackPanel>

          <TextBlock Text="Measurement" Style="{StaticResource SectionHeader}"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Wi-Fi scans per point" Style="{StaticResource Label}"/>
            <TextBox x:Name="ScansPerPoint" Text="2" Width="40"/>
          </StackPanel>
          <CheckBox x:Name="UseSpectrum" Content="Record spectrum with RF Explorer"/>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="Sweeps per range" Style="{StaticResource Label}"/>
            <TextBox x:Name="SweepsPerSegment" Text="15" Width="40"/>
          </StackPanel>
          <CheckBox x:Name="UseDwell" Content="Listen to the serving channel"
                    ToolTip="Parks the analyzer on the channel in use for a few seconds. Sweeps are too slow to catch short bursts, so this is what makes airtime figures trustworthy."/>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="for" Style="{StaticResource Label}"/>
            <TextBox x:Name="DwellSecondsBox" Text="3" Width="36"/>
            <TextBlock Text="seconds" Style="{StaticResource Label}"/>
          </StackPanel>
          <CheckBox x:Name="UsePcap" Content="Capture frames with a monitor adapter"
                    ToolTip="Needs a second adapter in monitor mode, chosen on the Capture tab. Gives retry rate, measured airtime, and client counts."/>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="for" Style="{StaticResource Label}"/>
            <TextBox x:Name="PcapSecondsBox" Text="8" Width="36"/>
            <TextBlock Text="seconds" Style="{StaticResource Label}"/>
          </StackPanel>
          <CheckBox x:Name="UseIperf" Content="Run iperf3 throughput test"/>
          <CheckBox x:Name="AutoGps" Content="Measure automatically as I walk (GPS)"
                    ToolTip="Needs GPS pins on the plan and a good fix. Measures every few meters."/>
          <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="Every" Style="{StaticResource Label}"/>
            <TextBox x:Name="AutoSpacing" Text="5" Width="40"/>
            <TextBlock Text="meters" Style="{StaticResource Label}"/>
          </StackPanel>
          <Button Content="Measure at my GPS position" Click="CaptureAtGps_Click" HorizontalAlignment="Left"/>
          <TextBlock x:Name="GpsInfo" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,4"/>
          <Button x:Name="CancelCapture" Content="Cancel measurement" Click="CancelCapture_Click"
                  Visibility="Collapsed" HorizontalAlignment="Left"/>

          <TextBlock Text="Heatmap" Style="{StaticResource SectionHeader}"/>
          <ComboBox x:Name="MetricBox" SelectionChanged="HeatmapOption_Changed"/>
          <TextBlock Text="Network (SSID)" Style="{StaticResource Label}"/>
          <ComboBox x:Name="SsidBox" SelectionChanged="Ssid_Changed"/>
          <TextBlock Text="Access point (BSSID)" Style="{StaticResource Label}"/>
          <ComboBox x:Name="BssidBox" SelectionChanged="HeatmapOption_Changed"/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Band" Style="{StaticResource Label}"/>
            <ComboBox x:Name="BandBox" SelectedIndex="0" SelectionChanged="HeatmapOption_Changed">
              <ComboBoxItem Content="All"/>
              <ComboBoxItem Content="2.4"/>
              <ComboBoxItem Content="5"/>
              <ComboBoxItem Content="6"/>
            </ComboBox>
            <TextBlock Text="Channel" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ChannelBox" SelectionChanged="HeatmapOption_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Fill up to" Style="{StaticResource Label}"/>
            <TextBox x:Name="RadiusBox" Text="8" Width="40" LostFocus="HeatmapOption_Changed"/>
            <TextBlock Text="meters from a point" Style="{StaticResource Label}"/>
          </StackPanel>
          <TextBlock Text="Opacity" Style="{StaticResource Label}"/>
          <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="0.6" ValueChanged="Opacity_Changed"
                  Margin="0,0,0,6"/>
          <CheckBox x:Name="ShowPoints" Content="Show measurement points" IsChecked="True"
                    Checked="ShowPoints_Changed" Unchecked="ShowPoints_Changed"/>
          <CheckBox x:Name="ShowWalk" Content="Show walk test and trouble spots" IsChecked="True"
                    Checked="ShowPoints_Changed" Unchecked="ShowPoints_Changed"/>
          <CheckBox x:Name="ShowGaps" Content="Show where to measure next"
                    Click="ShowPoints_Changed"
                    ToolTip="Shades the parts of the plan no measurement covers yet"/>
          <TextBlock x:Name="HeatmapHint" Style="{StaticResource Hint}"/>

          <TextBlock Text="What counts as good" Style="{StaticResource SectionHeader}"/>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Scores and verdicts are measured against these, so set them to whatever this site has to meet."/>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Signal at least" Style="{StaticResource Label}"/>
            <TextBox x:Name="TargetRssi" Width="46" LostFocus="Targets_Changed"/>
            <TextBlock Text="dBm" Style="{StaticResource Label}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="SNR at least" Style="{StaticResource Label}"/>
            <TextBox x:Name="TargetSnr" Width="46" LostFocus="Targets_Changed"/>
            <TextBlock Text="dB" Style="{StaticResource Label}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Airtime under" Style="{StaticResource Label}"/>
            <TextBox x:Name="TargetAirtime" Width="46" LostFocus="Targets_Changed"/>
            <TextBlock Text="%" Style="{StaticResource Label}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Link rate at least" Style="{StaticResource Label}"/>
            <TextBox x:Name="TargetPhy" Width="46" LostFocus="Targets_Changed"/>
            <TextBlock Text="Mbps" Style="{StaticResource Label}"/>
          </StackPanel>

          <TextBlock Text="Estimated sources" Style="{StaticResource SectionHeader}"/>
          <CheckBox x:Name="ShowApEstimates" Content="Where the access points are"
                    Click="Estimates_Changed"
                    ToolTip="Fits a path-loss model to the measured signal of each access point and marks the most likely position"/>
          <CheckBox x:Name="ShowInterferenceEstimate" Content="Where the noise is coming from"
                    Click="Estimates_Changed"
                    ToolTip="Searches the whole captured spectrum for emissions no network explains, groups them by frequency, and marks where each source probably is"/>
          <TextBlock x:Name="EstimateInfo" Style="{StaticResource Hint}"/>

          <TextBlock Text="Analysis" Style="{StaticResource SectionHeader}"/>
          <Button Content="Analysis report…" Click="Analysis_Click" HorizontalAlignment="Left"/>
          <TextBlock x:Name="AnalysisHint" Style="{StaticResource Hint}"/>

          <TextBlock Text="Export" Style="{StaticResource SectionHeader}"/>
          <WrapPanel>
            <Button Content="CSV…" Click="ExportCsv_Click"/>
            <Button Content="KML…" Click="ExportKml_Click"/>
            <Button Content="Image…" Click="ExportPng_Click"/>
            <Button Content="Report…" Click="ExportReport_Click"
                    ToolTip="One HTML file holding the map, scores, channel plan, findings, and every point"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Right: plan -->
    <Grid Grid.Column="1" x:Name="MapRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <WrapPanel Margin="10,8,10,2">
        <TextBlock Text="Zoom" Style="{StaticResource Label}"/>
        <Button Content="−" Click="ZoomOut_Click" MinWidth="40" FontSize="15"/>
        <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="4" Value="1" Width="160"
                ValueChanged="Zoom_Changed" Margin="4,0,4,6" VerticalAlignment="Center"/>
        <Button Content="+" Click="ZoomIn_Click" MinWidth="40" FontSize="15"/>
        <Button Content="Fit to window" Click="Fit_Click"/>
        <Button Content="Full screen" Click="FullScreen_Click"/>
        <ToggleButton x:Name="TouchEdit" Content="Drag to edit" Click="TouchEdit_Click" Padding="10,3"
                      Margin="0,0,6,6"
                      ToolTip="Off: one finger pans the map. On: one finger draws and drags walls and points instead, and pinch still zooms."/>
        <TextBlock x:Name="CursorInfo" Style="{StaticResource Label}" Margin="12,0,0,6"/>
      </WrapPanel>

      <ScrollViewer x:Name="PlanScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto" Background="#E6E9EE"
                    PanningMode="None" IsManipulationEnabled="True"
                    ManipulationStarting="Plan_ManipulationStarting"
                    ManipulationDelta="Plan_ManipulationDelta"
                    ManipulationInertiaStarting="Plan_InertiaStarting"
                    PreviewMouseWheel="Plan_MouseWheel">
        <Grid x:Name="PlanHost" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
          <Grid.LayoutTransform>
            <ScaleTransform x:Name="PlanScale" ScaleX="1" ScaleY="1"/>
          </Grid.LayoutTransform>
          <Image x:Name="PlanImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Image x:Name="HeatmapImage" Stretch="Fill" Opacity="0.6" IsHitTestVisible="False"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 RenderOptions.BitmapScalingMode="Linear"/>
          <Canvas x:Name="Overlay" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove"
                  MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                  TouchDown="Overlay_TouchDown" TouchUp="Overlay_TouchUp"/>
          <!-- Kept out of Overlay so redrawing the map doesn't restart the spinner -->
          <Canvas x:Name="BusyLayer" IsHitTestVisible="False" HorizontalAlignment="Left"
                  VerticalAlignment="Top"/>
        </Grid>
      </ScrollViewer>

      <Border x:Name="FullScreenBar" Grid.Row="1" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0"
              Background="#F2FFFFFF" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1"
              CornerRadius="6" Padding="8,6" Panel.ZIndex="5">
        <StackPanel Orientation="Horizontal">
          <Button Content="−" Click="ZoomOut_Click" MinWidth="46" MinHeight="40" FontSize="17"/>
          <Button Content="+" Click="ZoomIn_Click" MinWidth="46" MinHeight="40" FontSize="17"/>
          <Button Content="Fit" Click="Fit_Click" MinWidth="56" MinHeight="40"/>
          <ToggleButton x:Name="TouchEditFull" Content="Drag to edit" Click="TouchEdit_Click"
                        Padding="12,3" MinHeight="40" Margin="0,0,6,6"/>
          <Button Content="Exit full screen" Click="FullScreen_Click" MinWidth="130" MinHeight="40"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Padding="12,8" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="LegendTitle" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <StackPanel x:Name="LegendGradient" Orientation="Horizontal">
            <TextBlock x:Name="LegendMin" VerticalAlignment="Center"/>
            <Border x:Name="LegendBar" Width="320" Height="14" Margin="8,0" CornerRadius="2"/>
            <TextBlock x:Name="LegendMax" VerticalAlignment="Center"/>
          </StackPanel>
          <ItemsControl x:Name="LegendCategories" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                  <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Swatch}"
                          VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
