<UserControl x:Class="WifiSurveyor.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="400"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="Adapter" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="AdapterBox" Width="250"/>
          <Button Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Windows names adapters differently in different places. Most tools below want the name from Network Connections (often 'Wi-Fi' or 'Wi-Fi 2')."/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Connection name" Style="{StaticResource Label}"/>
          <TextBox x:Name="ConnectionName" Width="140" Text="Wi-Fi"/>
          <TextBlock Text="Channel" Style="{StaticResource Label}"/>
          <TextBox x:Name="ChannelBox" Width="50"/>
        </StackPanel>

        <TextBlock Text="Does this adapter do monitor mode?" Style="{StaticResource SectionHeader}"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Windows itself knows the answer: the driver reports whether it supports network monitor mode. This is the first thing to check before blaming anything else."/>
        <Button Content="Ask the driver (netsh wlan show drivers)" Click="ShowDrivers_Click"
                HorizontalAlignment="Left"/>

        <TextBlock Text="Npcap" Style="{StaticResource SectionHeader}"/>
        <WrapPanel>
          <Button Content="List capture adapters" Click="ListCapture_Click"/>
          <Button Content="Supported modes" Click="WlanHelperModes_Click"/>
          <Button Content="Monitor mode on" Click="MonitorOn_Click"/>
          <Button Content="Managed mode" Click="MonitorOff_Click"/>
          <Button Content="Set channel" Click="SetChannel_Click"/>
        </WrapPanel>

        <TextBlock Text="Wireshark and tshark" Style="{StaticResource SectionHeader}"/>
        <TextBlock x:Name="WiresharkState" Style="{StaticResource Hint}"/>
        <WrapPanel>
          <Button Content="Open Wireshark" Click="Wireshark_Click"/>
          <Button Content="List tshark interfaces" Click="TsharkList_Click"/>
          <Button x:Name="TsharkCaptureButton" Content="Capture with tshark" Click="TsharkCapture_Click"/>
          <TextBlock Text="for" Style="{StaticResource Label}"/>
          <TextBox x:Name="TsharkSeconds" Width="40" Text="15"/>
          <TextBlock Text="seconds" Style="{StaticResource Label}"/>
        </WrapPanel>
        <TextBlock Style="{StaticResource Hint}"
                   Text="A tshark capture is written to the data folder and can be opened on the Capture tab, which works out retries, airtime, client counts, and beacon details from it."/>

        <TextBlock Text="Windows Wi-Fi tools" Style="{StaticResource SectionHeader}"/>
        <WrapPanel>
          <Button Content="Interfaces" Click="ShowInterfaces_Click"/>
          <Button Content="Networks with BSSIDs" Click="ShowNetworks_Click"/>
          <Button Content="Saved profiles" Click="ShowProfiles_Click"/>
          <Button Content="Wi-Fi history report" Click="WlanReport_Click"
                  ToolTip="Builds Windows' own HTML report of recent connections, disconnects, and errors"/>
        </WrapPanel>

        <TextBlock Text="Not on Windows" Style="{StaticResource SectionHeader}"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="airodump-ng, Kismet, and horst are Linux tools. Both Alfa adapters are well supported there, and a capture taken on Linux opens on the Capture tab exactly like a local one."/>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <WrapPanel>
        <TextBlock x:Name="OutputTitle" Style="{StaticResource Label}" Text="Output"/>
        <Button Content="Copy" Click="Copy_Click"/>
        <Button Content="Clear" Click="Clear_Click"/>
      </WrapPanel>
      <Border Grid.Row="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
        <TextBox x:Name="OutputText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </Border>
    </Grid>
  </Grid>
</UserControl>
