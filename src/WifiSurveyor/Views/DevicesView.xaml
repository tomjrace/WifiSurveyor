<UserControl x:Class="WifiSurveyor.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,8,20,20" MaxWidth="780" HorizontalAlignment="Left">

      <TextBlock Text="RF Explorer spectrum analyzer" Style="{StaticResource SectionHeader}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Port" Style="{StaticResource Label}"/>
        <ComboBox x:Name="RfePort" Width="360"/>
        <TextBlock Text="Baud" Style="{StaticResource Label}"/>
        <ComboBox x:Name="RfeBaud" Width="90" SelectedIndex="0">
          <ComboBoxItem Content="500000"/>
          <ComboBoxItem Content="2400"/>
        </ComboBox>
        <Button Content="Refresh ports" Click="RefreshPorts_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Connect" Click="RfeConnect_Click"/>
        <Button Content="Disconnect" Click="RfeDisconnect_Click"/>
      </StackPanel>
      <TextBlock x:Name="RfeStatus" Style="{StaticResource Hint}" Foreground="{StaticResource InkBrush}"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="Put the 2.4 GHz helical antenna on the right (WSUB3G) port and the 5.8 GHz antenna on the left (6G) port. If no COM port appears, install the Silicon Labs CP210x USB driver. The baud rate must match the setting in the device menu."/>

      <TextBlock Text="GPS" Style="{StaticResource SectionHeader}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Source" Style="{StaticResource Label}"/>
        <ComboBox x:Name="GpsSource" Width="200" SelectedIndex="1">
          <ComboBoxItem Content="None"/>
          <ComboBoxItem Content="USB GPS (NMEA serial)"/>
          <ComboBoxItem Content="Windows Location"/>
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Port" Style="{StaticResource Label}"/>
        <ComboBox x:Name="GpsPort" Width="360"/>
        <TextBlock Text="Baud" Style="{StaticResource Label}"/>
        <ComboBox x:Name="GpsBaud" Width="90" SelectedIndex="1">
          <ComboBoxItem Content="4800"/>
          <ComboBoxItem Content="9600"/>
          <ComboBoxItem Content="38400"/>
          <ComboBoxItem Content="115200"/>
        </ComboBox>
        <Button Content="Find GPS port" Click="GpsDetect_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Start GPS" Click="GpsStart_Click"/>
        <Button Content="Stop GPS" Click="GpsStop_Click"/>
      </StackPanel>
      <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" Padding="10,6" Margin="0,2,0,4">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="FixDot" Width="12" Height="12" Fill="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="FixText" Text="GPS is off." TextWrapping="Wrap" MaxWidth="700"/>
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Hint}"
                 Text="Green means the fix is good enough to place points automatically (HDOP 2 or lower with 5+ satellites, or ±5 m accuracy). Indoors, expect orange or red and place points by clicking."/>

      <TextBlock Text="Throughput testing (iperf3)" Style="{StaticResource SectionHeader}"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="iperf3.exe" Style="{StaticResource Label}"/>
        <TextBox x:Name="IperfPath" Width="420"/>
        <Button Content="Browse…" Click="IperfBrowse_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Server" Style="{StaticResource Label}"/>
        <TextBox x:Name="IperfServer" Width="200" ToolTip="Host running: iperf3 -s"/>
        <TextBlock Text="Port" Style="{StaticResource Label}"/>
        <TextBox x:Name="IperfPort" Width="55" Text="5201"/>
        <TextBlock Text="Seconds per direction" Style="{StaticResource Label}"/>
        <TextBox x:Name="IperfSeconds" Width="40"/>
        <Button Content="Run test" Click="IperfTest_Click"/>
      </StackPanel>
      <TextBlock x:Name="IperfResult" Style="{StaticResource Hint}" Foreground="{StaticResource InkBrush}"/>

      <TextBlock Text="Or pick a public server" Style="{StaticResource Label}" Margin="0,8,0,4"/>
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="RegionBox" Width="150" SelectionChanged="Region_Changed"/>
        <ComboBox x:Name="CountryBox" Width="90" SelectionChanged="Country_Changed"/>
        <ComboBox x:Name="PublicServerBox" Width="330" SelectionChanged="PublicServer_Changed"/>
        <Button x:Name="RefreshServersButton" Content="Update list" Click="RefreshServers_Click"/>
      </StackPanel>
      <TextBlock x:Name="ServerListInfo" Style="{StaticResource Hint}"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="Public servers measure the path to the internet, so they're limited by your uplink and by whatever load the server is under. For mapping Wi-Fi capacity, a machine on your own LAN running iperf3 -s is far better; use these for internet reach, or when there's no LAN server to hand."/>

      <TextBlock Text="Wi-Fi scanning" Style="{StaticResource SectionHeader}"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Open location settings" Click="LocationSettings_Click"/>
        <Button Content="Open data folder" Click="DataFolder_Click"/>
      </StackPanel>
      <TextBlock x:Name="OuiInfo" Style="{StaticResource Hint}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
