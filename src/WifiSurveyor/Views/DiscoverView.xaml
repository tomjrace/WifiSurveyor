<UserControl x:Class="WifiSurveyor.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="280"/>
    </Grid.RowDefinitions>

    <WrapPanel>
      <Button x:Name="ScanButton" Content="Scan now" Click="ScanButton_Click"/>
      <CheckBox x:Name="AutoRefresh" Content="Rescan every 5 seconds" IsChecked="True"
                Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
      <TextBlock Text="Band" Style="{StaticResource Label}"/>
      <ComboBox x:Name="BandFilter" SelectedIndex="0" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="All"/>
        <ComboBoxItem Content="2.4"/>
        <ComboBoxItem Content="5"/>
        <ComboBoxItem Content="6"/>
      </ComboBox>
      <TextBlock Text="Find" Style="{StaticResource Label}"/>
      <TextBox x:Name="SearchBox" Width="200" TextChanged="Filter_Changed"
               ToolTip="Matches SSID, BSSID, or vendor"/>
      <CheckBox x:Name="MergeAdapters" Content="Merge duplicates from other adapters"
                Click="Merge_Changed"
                ToolTip="Windows lists every network once per WLAN adapter. With this on, each access point is shown once, at the strongest reading any adapter heard."/>
      <TextBlock x:Name="ScanStatus" Style="{StaticResource Label}" Margin="8,0,0,6"/>
    </WrapPanel>

    <DataGrid x:Name="NetworkGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{StaticResource RuleBrush}" BorderBrush="{StaticResource RuleBrush}"
              CanUserAddRows="False" RowHeight="24" SelectionChanged="NetworkGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="2*"/>
        <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="140"/>
        <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="1.5*"/>
        <DataGridTextColumn Header="Band (GHz)" Binding="{Binding Band}" Width="80"/>
        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="70"/>
        <DataGridTextColumn Header="Signal (dBm)" Binding="{Binding Rssi}" Width="95"/>
        <DataGridTextColumn Header="Min" Binding="{Binding MinRssi}" Width="55"/>
        <DataGridTextColumn Header="Max" Binding="{Binding MaxRssi}" Width="55"/>
        <DataGridTextColumn Header="Quality (%)" Binding="{Binding LinkQuality}" Width="85"/>
        <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="80"/>
        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="80"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="6" Background="Transparent"/>

    <TabControl Grid.Row="3">
      <TabItem Header="Signal over time">
        <Canvas x:Name="HistoryCanvas" Background="White" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
      </TabItem>
      <TabItem Header="Channel map">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Canvas x:Name="Channels24Canvas" Background="White" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
          <Canvas x:Name="Channels5Canvas" Grid.Column="1" Background="White" ClipToBounds="True"
                  SizeChanged="Chart_SizeChanged"/>
          <Canvas x:Name="Channels6Canvas" Grid.Column="2" Background="White" ClipToBounds="True"
                  SizeChanged="Chart_SizeChanged"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
