<Application x:Class="WifiSurveyor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Palette: instrument-panel slate with a single signal-blue accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#D9DEE5"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6778"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FEF3C7"/>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="MinWidth" Value="70"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,12,8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Application.Resources>
</Application>
