<Window x:Class="WifiSurveyor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WifiSurveyor.Views"
        Title="Wi-Fi Surveyor" Height="880" Width="1440" MinWidth="960" MinHeight="600"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{StaticResource InkBrush}" Background="White">
  <Grid>
  <DockPanel x:Name="MainLayout">
    <Menu x:Name="MenuBar" DockPanel.Dock="Top" Background="Transparent">
      <MenuItem Header="_Help">
        <MenuItem Header="_Setup and about" Click="About_Click"/>
        <MenuItem Header="Third-party _notices…" Click="Notices_Click"/>
        <Separator/>
        <MenuItem Header="Open the _data folder" Click="DataFolder_Click"/>
      </MenuItem>
    </Menu>
    <Border x:Name="LocationBanner" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="{StaticResource WarnBrush}" Padding="12,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center"
                   Text="Windows blocks Wi-Fi scan results until location access is allowed for desktop apps."/>
        <Button Content="Open location settings" Margin="12,0,0,0" Click="OpenLocationSettings_Click"/>
      </StackPanel>
    </Border>

    <StatusBar x:Name="StatusBarMain" DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}">
      <StatusBarItem>
        <TextBlock x:Name="RfeStatusText" Text="RF Explorer: not connected"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="GpsStatusText" Text="GPS: off"/>
      </StatusBarItem>
    </StatusBar>

    <TabControl BorderThickness="0,1,0,0" Padding="0">
      <TabItem Header="Discover"><v:DiscoverView/></TabItem>
      <TabItem Header="Spectrum"><v:SpectrumView/></TabItem>
      <TabItem Header="Survey"><v:SurveyView x:Name="SurveyTab"/></TabItem>
      <TabItem Header="Capture"><v:CaptureView/></TabItem>
      <TabItem Header="Tools"><v:ToolsView/></TabItem>
      <TabItem Header="Load Test"><v:ClientsView/></TabItem>
      <TabItem Header="Devices"><v:DevicesView/></TabItem>
      <TabItem Header="Setup &amp; About" x:Name="SetupTab"><v:SetupView/></TabItem>
    </TabControl>
  </DockPanel>

    <!-- The survey map is moved in here for full screen, then moved back -->
    <Grid x:Name="FullScreenHost" Visibility="Collapsed" Background="White" Panel.ZIndex="10"/>
  </Grid>
</Window>
