# ---- Build and tool clutter ----
.venv/
venv/
build/
dist/
*.egg-info/
__pycache__/
*.pyc
bin/
obj/
.vs/
.vscode/
.idea/
*.user
*.swp
*~
.DS_Store

# ---- Personal data: never committed ----
# The app saves all of this in your home folder (~/Documents/Wi-Fi Surveys and
# ~/.local/share/wifisurveyor), never in here. These rules are a safety net in case a
# file is ever copied or saved into the project by hand.

# Surveys, reports and exports
*.wsurvey
*.wsurvey.tmp
*report*.html
*incidents*.csv
*.kml
*.kmz

# Frame captures and radio recordings
*.pcap
*.pcapng
*.cap
*.sigmf-data
*.sigmf-meta
*.iq
*.cs8
*.cu8
*.raw

# Watch (monitor) sessions and app data folders
session.jsonl
*.jsonl
monitor/
captures/
iq/
updates/

# Settings, recent-survey list, recovery copies
settings.json
library.json
recovery.wsurvey
iperf-servers.json

# Downloaded manufacturer registries (public, but large and regenerated by the app)
oui.csv
oui36.csv
mam.csv
iab.csv

# Anything that could hold a password or key
*.nmconnection
.env
*.env
*.key
*.pem
*.p12
*.pfx
secrets*
